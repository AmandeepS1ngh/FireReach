# ========================================
# FireReach – Environment Configuration
# ========================================

# --- Service Ports ---
API_GATEWAY_PORT=3000
AGENT_SERVICE_PORT=3001
SIGNAL_SERVICE_PORT=3002
RESEARCH_SERVICE_PORT=3003
OUTREACH_SERVICE_PORT=3004

# --- Groq LLM ---
GROQ_API_KEY=your_groq_api_key_here

# --- Serper API (Signal Harvesting) ---
SERPER_API_KEY=your_serper_api_key_here

# --- SMTP (Email Sending via Nodemailer) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM=your_email@gmail.com

# --- Service URLs (used internally) ---
AGENT_SERVICE_URL=http://localhost:3001
SIGNAL_SERVICE_URL=http://localhost:3002
RESEARCH_SERVICE_URL=http://localhost:3003
OUTREACH_SERVICE_URL=http://localhost:3004
